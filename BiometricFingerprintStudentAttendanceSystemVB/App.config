<configuration>
   <configSections>
    </configSections>
    <connectionStrings>
        <add name="BiometricFingerprintStudentAttendanceSystemVB.My.MySettings.biometricdbConnectionString"
            connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\biometricdb.mdf;Integrated Security=True"
            providerName="System.Data.SqlClient" />
      <add name="BiometricFingerprintStudentAttendanceSystemVB.My.MySettings.biometricdbConnectionString"
            connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\biometricdb.mdf;Integrated Security=True"
            providerName="System.Data.SqlClient" />
        <add name="BiometricFingerprintStudentAttendanceSystemVB.My.MySettings.biometricdbConnectionString1"
